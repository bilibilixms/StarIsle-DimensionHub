{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@starisle/user/*": ["apps/user-miniapp/src/components/*"],
      "@starisle/ui/MerchantWorkspace.vue": [
        "apps/merchant-miniapp/src/components/MerchantWorkspace.vue"
      ]
    },
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM"],
    "types": ["@dcloudio/types", "vite/client"]
  }
}
