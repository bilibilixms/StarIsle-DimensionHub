{
  "name": "starisle-dimensionhub",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=22.23.4 <23", "npm": ">=10 <11" },
  "packageManager": "npm@10.9.9",
  "scripts": {
    "dev:user": "npm run dev:mp-weixin --workspace @starisle/user-miniapp",
    "dev:merchant": "npm run dev:mp-weixin --workspace @starisle/merchant-miniapp",
    "dev:user:h5": "npm run dev:h5 --workspace @starisle/user-miniapp",
    "dev:merchant:h5": "npm run dev:h5 --workspace @starisle/merchant-miniapp",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build:mp-weixin --workspaces --if-present",
    "build:h5": "npm run build:h5 --workspaces --if-present"
  }
}
